# Environment Configuration for My Agentic Tool
# Copy this file to .env and edit with your values

# Development Mode (set to true for local testing without AWS)
USE_MOCK_SERVICES=true

# AWS Configuration (uncomment for production)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_DEFAULT_REGION=us-east-1

# Logging
LOG_LEVEL=INFO

# Data Sources
DATA_SOURCE_PATH=./data/input
DATA_OUTPUT_PATH=./data/output

# Pipeline Settings
BATCH_SIZE=1000
MAX_RETRIES=3

# Airflow Configuration (if using Airflow)
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
