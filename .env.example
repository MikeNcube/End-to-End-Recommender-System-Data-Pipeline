# ── Environment Configuration ─────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# The .env file is excluded from version control (see .gitignore).
#
# Usage:
#   cp .env.example .env
#   # then edit .env with real values

# ── Development mode ─────────────────────────────────────────────────────────
# Set to "true" to run locally without any AWS resources.
# Mock stubs are used for Kinesis, S3, etc.
USE_MOCK_SERVICES=true

# ── AWS credentials ───────────────────────────────────────────────────────────
# Required when USE_MOCK_SERVICES=false.
# Alternatively, configure via ~/.aws/credentials or IAM instance role.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# ── AWS resource names ────────────────────────────────────────────────────────
# Kinesis stream that receives pipeline records (src/main.py)
KINESIS_STREAM_NAME=example-stream
# S3 bucket used for data storage
S3_BUCKET_NAME=your-data-bucket

# ── Logging ───────────────────────────────────────────────────────────────────
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Local data paths ──────────────────────────────────────────────────────────
# Relative to the project root
DATA_SOURCE_PATH=./data/input
DATA_OUTPUT_PATH=./data/output

# ── Pipeline tuning ───────────────────────────────────────────────────────────
BATCH_SIZE=1000
MAX_RETRIES=3

# ── Airflow (only needed when running with Airflow directly) ──────────────────
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
